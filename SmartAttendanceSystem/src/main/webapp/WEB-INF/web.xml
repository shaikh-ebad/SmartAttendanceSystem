<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">
	
	<welcome-file-list>
    <welcome-file>login.jsp</welcome-file>
	</welcome-file-list>
	
 


  <servlet>
    <servlet-name>LoginServlet</servlet-name>
    <servlet-class>controller.LoginServlet</servlet-class>
  </servlet>

  <servlet-mapping>
    <servlet-name>LoginServlet</servlet-name>
    <url-pattern>/login</url-pattern>
  </servlet-mapping>

 

	<servlet>
    <servlet-name>TimetableServlet</servlet-name>
    <servlet-class>controller.TimetableServlet</servlet-class>
	</servlet>

	<servlet-mapping>
    <servlet-name>TimetableServlet</servlet-name>
    <url-pattern>/timetable</url-pattern>
	</servlet-mapping>
	
	<servlet>
    <servlet-name>AdminServlet</servlet-name>
    <servlet-class>controller.AdminServlet</servlet-class>
	</servlet>

	<servlet-mapping>
    <servlet-name>AdminServlet</servlet-name>
    <url-pattern>/admin</url-pattern>
	</servlet-mapping>
	
	<servlet>
    <servlet-name>HolidayServlet</servlet-name>
    <servlet-class>controller.HolidayServlet</servlet-class>
	</servlet>

	<servlet-mapping>
    <servlet-name>HolidayServlet</servlet-name>
    <url-pattern>/holiday</url-pattern>
	</servlet-mapping>
	
	<servlet>
    <servlet-name>TeacherCreateServlet</servlet-name>
    <servlet-class>controller.TeacherCreateServlet</servlet-class>
	</servlet>
	<servlet-mapping>
    <servlet-name>TeacherCreateServlet</servlet-name>
    <url-pattern>/teacherCreate</url-pattern>
	</servlet-mapping>

	<servlet>
    <servlet-name>StudentCreateServlet</servlet-name>
    <servlet-class>controller.StudentCreateServlet</servlet-class>
	</servlet>
	<servlet-mapping>
    <servlet-name>StudentCreateServlet</servlet-name>
    <url-pattern>/studentCreate</url-pattern>
	</servlet-mapping>
	
	
	
	<servlet>
    <servlet-name>AttendanceServlet</servlet-name>
    <servlet-class>controller.AttendanceServlet</servlet-class>
	</servlet>

	<servlet-mapping>
    <servlet-name>AttendanceServlet</servlet-name>
    <url-pattern>/markAttendance</url-pattern>
	</servlet-mapping>
	
	
	
	<servlet>
    <servlet-name>ClassCreateServlet</servlet-name>
    <servlet-class>controller.ClassCreateServlet</servlet-class>
	</servlet>

	<servlet-mapping>
    <servlet-name>ClassCreateServlet</servlet-name>
    <url-pattern>/classCreate</url-pattern>
	</servlet-mapping>
	
	<servlet>
    <servlet-name>SubjectCreateServlet</servlet-name>
    <servlet-class>controller.SubjectCreateServlet</servlet-class>
	</servlet>

	<servlet-mapping>
    <servlet-name>SubjectCreateServlet</servlet-name>
    <url-pattern>/admin/createSubject</url-pattern>
	</servlet-mapping>


	
	<servlet>
    <servlet-name>LogoutServlet</servlet-name>
    <servlet-class>controller.LogoutServlet</servlet-class>
</servlet>

<servlet-mapping>
    <servlet-name>LogoutServlet</servlet-name>
    <url-pattern>/logout</url-pattern>
</servlet-mapping>
	
	
</web-app>
